<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<style>
  @font-face-css-placeholder
  :root {
    --font-headline: {{fontFamily.headline}};
    --font-name: {{fontFamily.name}};
    --font-footer: {{fontFamily.footer}};
    --font-accent: {{fontFamily.accent}};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { width: 1200px; height: 1600px; overflow: hidden; }
  .poster {
    position: relative;
    width: 1200px;
    height: 1600px;
    background: {{palette.background}};
    overflow: hidden;
  }
  /* Decorative top bar */
  .top-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 40px;
    background: {{palette.primary}};
  }
  .bottom-bar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 80px;
    background: {{palette.primary}};
  }
  /* Photos */
  .photo {
    position: absolute;
    object-fit: cover;
    border: 8px solid {{palette.accent}};
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  .photo-1 { left: 120px;  top: 180px; width: 420px; height: 520px; }
  .photo-2 { right: 120px; top: 180px; width: 420px; height: 520px; }
  /* Headline */
  .headline-block {
    position: absolute;
    left: 60px;
    right: 60px;
    top: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .headline {
    text-align: center;
    font-family: var(--font-headline);
    font-weight: {{fontWeight.headline}};
    font-size: {{headlineSizePx}}px;
    line-height: 1.05;
    color: {{palette.text}};
    text-shadow: {{headlineShadowCss}};
  }
  /* Accent (decorative subheadline) */
  .accent {
    text-align: center;
    font-family: var(--font-accent);
    font-weight: {{fontWeight.accent}};
    font-size: 52px;
    color: {{palette.accent}};
    text-shadow: 2px 2px 0 rgba(0,0,0,0.5);
  }
  /* Name + designation */
  .name {
    position: absolute;
    left: 0; right: 0; top: 1280px;
    text-align: center;
    font-family: var(--font-name);
    font-weight: {{fontWeight.name}};
    font-size: 52px;
    color: {{palette.text}};
    text-shadow: 2px 2px 6px rgba(0,0,0,0.7);
  }
  .designation {
    position: absolute;
    left: 0; right: 0; top: 1350px;
    text-align: center;
    font-family: var(--font-name);
    font-weight: 500;
    font-size: 36px;
    color: {{palette.text}};
    opacity: 0.95;
  }
  /* Footer */
  .footer {
    position: absolute;
    left: 0; right: 0; bottom: 20px;
    text-align: center;
    font-family: var(--font-footer);
    font-weight: {{fontWeight.footer}};
    font-size: 28px;
    color: {{palette.text}};
  }
</style>
</head>
<body>
  <div class="poster">
    <div class="top-bar"></div>
    <div class="bottom-bar"></div>

    {{#if photoUrls.[0]}}
      <img
        class="photo photo-1"
        src="{{photoUrls.[0]}}"
        style="object-position: {{photoStyles.[0].objectPosition}};"
      />
    {{/if}}
    {{#if photoUrls.[1]}}
      <img
        class="photo photo-2"
        src="{{photoUrls.[1]}}"
        style="object-position: {{photoStyles.[1].objectPosition}};"
      />
    {{/if}}

    <div class="headline-block">
      <div class="headline">{{headline}}</div>
      {{#if subheadline}}
        <div class="accent">{{subheadline}}</div>
      {{/if}}
    </div>

    <div class="name">{{name}}</div>
    <div class="designation">{{designation}}</div>

    <div class="footer">প্রচারে: {{party}} — {{district}}</div>
  </div>
</body>
</html>