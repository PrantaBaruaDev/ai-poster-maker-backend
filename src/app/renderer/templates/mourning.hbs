<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<style>
  @font-face-css-placeholder
  :root {
    --font-headline: {{fontFamily.serif}};
    --font-name: {{fontFamily.name}};
    --font-footer: {{fontFamily.footer}};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { width: 1200px; height: 1600px; overflow: hidden; }
  .poster {
    position: relative;
    width: 1200px;
    height: 1600px;
    background: {{palette.background}};
    border: 20px solid {{palette.accent}};
  }
  .photo-wrap {
    position: absolute;
    left: 50%; top: 160px;
    transform: translateX(-50%);
    width: 400px; height: 480px;
    border-radius: 50%;
    overflow: hidden;
    border: 8px solid {{palette.accent}};
    box-shadow: 0 10px 40px rgba(255,255,255,0.15);
  }
  .photo-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .headline {
    position: absolute;
    left: 0; right: 0; top: 700px;
    text-align: center;
    font-family: var(--font-headline);
    font-weight: {{fontWeight.serif}};
    font-size: 110px;
    color: {{palette.text}};
    letter-spacing: 2px;
  }
  .name {
    position: absolute;
    left: 0; right: 0; top: 900px;
    text-align: center;
    font-family: var(--font-name);
    font-weight: {{fontWeight.name}};
    font-size: 54px;
    color: {{palette.text}};
  }
  .designation {
    position: absolute;
    left: 0; right: 0; top: 980px;
    text-align: center;
    font-family: var(--font-name);
    font-size: 38px;
    color: {{palette.text}};
    opacity: 0.9;
  }
  .tribute {
    position: absolute;
    left: 120px; right: 120px; top: 1200px;
    text-align: center;
    font-family: var(--font-name);
    font-size: 44px;
    line-height: 1.4;
    color: {{palette.text}};
    opacity: 0.95;
  }
  .footer {
    position: absolute;
    left: 0; right: 0; bottom: 60px;
    text-align: center;
    font-family: var(--font-footer);
    font-weight: {{fontWeight.footer}};
    font-size: 28px;
    color: {{palette.text}};
  }
</style>
</head>
<body>
  <div class="poster">
    {{#if photoUrls.[0]}}
    <div class="photo-wrap"><img src="{{photoUrls.[0]}}" /></div>
    {{/if}}

    <div class="headline">{{headline}}</div>
    <div class="name">{{name}}</div>
    <div class="designation">{{designation}}</div>

    {{#if tribute}}<div class="tribute">{{tribute}}</div>{{/if}}

    <div class="footer">প্রচারে: {{party}} — {{district}}</div>
  </div>
</body>
</html>