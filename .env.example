# Server
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://user:password@host:5432/poster_maker?schema=public"

# Auth
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=
BCRYPT_SALT_ROUNDS=10

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=poster-maker

REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=


# Limits
MAX_RETRIES=3
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_POSTER_MAX=10
RATE_LIMIT_UPLOAD_MAX=30

# Upload
MAX_UPLOAD_BYTES=5242880
MAX_PHOTOS_PER_POSTER=3